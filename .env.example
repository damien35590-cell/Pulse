# Base de données Neon : branche « dev » uniquement. L'adresse de prod vit seulement dans Vercel (variables Production).
# Collez la MÊME adresse dans les deux lignes (connexion « directe », sans « pooler »), ici ET dans .env.local :
# Prisma CLI (migrate, scripts tools/) lit .env, Next lit .env.local en priorité.
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Connexion : une seule personne
ALLOWED_EMAIL="vous@exemple.fr"
APP_PASSWORD="un-mot-de-passe-long-et-unique"

# Sécurité des sessions : 32 caractères aléatoires ou plus
NEXTAUTH_SECRET=""
# L'adresse publique de l'app, à renseigner après le premier déploiement
NEXTAUTH_URL="https://votre-app.vercel.app"

# Synchro MyWhoosh via Intervals.icu (réglages Intervals.icu > Developer > Create API Key)
INTERVALS_API_KEY=""
# Courses arrivées via Strava (lib/sync/intervals-runs.ts) : valeur du cookie de session web « i » d'intervals.icu
INTERVALS_SESSION_COOKIE=""
# Facultatif : id athlète Intervals.icu (iXXXXX) ; vide = « 0 », l'athlète de la clé API
INTERVALS_ATHLETE_ID=""
# Mot de passe du « cron » quotidien de Vercel : 32 caractères aléatoires ou plus
CRON_SECRET=""
# Facultatif : envoi depuis un script sur le PC
INGEST_TOKEN=""

# Itinéraires : clé gratuite OpenRouteService (openrouteservice.org > Dashboard > Tokens), côté serveur uniquement
ORS_API_KEY=""

# Coach IA de la page Analyse (console.anthropic.com > API Keys), côté serveur uniquement. Facturé à l'usage : quelques centimes par mois.
ANTHROPIC_API_KEY=""
# Facultatif : modèle du coach (par défaut claude-sonnet-5-5 ; claude-haiku-5-5 encore moins cher)
COACH_MODEL=""

# Facultatif : connexion Google en plus du mot de passe
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
