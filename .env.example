# Base de données Neon : collez la MÊME adresse dans les deux lignes (connexion « directe », sans « pooler »)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Connexion : une seule personne
ALLOWED_EMAIL="vous@exemple.fr"
APP_PASSWORD="un-mot-de-passe-long-et-unique"

# Sécurité des sessions : 32 caractères aléatoires ou plus
NEXTAUTH_SECRET=""
# L'adresse publique de l'app, à renseigner après le premier déploiement
NEXTAUTH_URL="https://votre-app.vercel.app"

# Synchro MyWhoosh via Intervals.icu (réglages Intervals.icu > Developer > Create API Key)
INTERVALS_API_KEY=""
# Mot de passe du « cron » quotidien de Vercel : 32 caractères aléatoires ou plus
CRON_SECRET=""
# Facultatif : envoi depuis un script sur le PC
INGEST_TOKEN=""

# Facultatif : connexion Google en plus du mot de passe
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
