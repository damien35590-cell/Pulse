generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")
  directUrl = env("DIRECT_URL")
}

// ───────── Enums ─────────
enum ActivityType {
  RUN
  RIDE
  EBIKE
  SWIM
  HIKE
  WALK
  WORKOUT
  OTHER
}
enum Feeling {
  GREAT
  GOOD
  OK
  TIRED
  HARD
}
enum GoalMetric {
  DISTANCE
  TIME
  ELEVATION
  ACTIVITIES
}
enum GoalPeriod {
  WEEK
  MONTH
  YEAR
}
enum RecordKind {
  LONGEST_DISTANCE
  LONGEST_TIME
  BEST_5K
  BEST_10K
  BEST_HALF
  BEST_ELEVATION
}
enum GearKind {
  BIKE
  EBIKE
  TRAINER
  SHOES
  CHAIN
  CASSETTE
  TIRE
  OTHER
}
enum RacePlatform {
  NEXTRUN
  KLIKEGO
  OTHER
}
enum RaceStatus {
  REGISTERED
  COMPLETED
  DNS
  DNF
}
/// Moitié du corps travaillée par une séance de muscu (alternance Lafay) ; LIBRE = mélangée ou inconnue.
enum WorkoutKind {
  HAUT
  BAS
  LIBRE
}

// ───────── Auth (NextAuth + PrismaAdapter) ─────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  bio           String?
  weightKg      Float?    // estimation des calories
  timezone      String    @default("Europe/Paris")
  ageBand       String?   // "30-39" : sert aux repères de comparaison
  sex           String?   // "H" | "F"
  homeLat       Float?    // domicile : départ par défaut des itinéraires
  homeLng       Float?
  homeEquipment String[]  @default([]) // « Mon matériel » (valeurs de Equipment dans lib/workout/catalog-data.ts) ; vide = matériel par défaut
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  activities Activity[]
  goals      Goal[]
  plans      TrainingPlan[]
  zones      UserZones?
  events     RaceEvent[]
  records    PersonalRecord[]
  badges     UserBadge[]
  gear       Gear[]

  workoutTemplates WorkoutTemplate[]

  // Programmes v2
  programs        Program[]
  trainingGoals   TrainingGoal[]
  plannedSessions PlannedSession[]
  athleteMetrics  AthleteMetric[]

  suggestedRoutes SuggestedRoute[]
  habitMaps       HabitMap[]

  // Notifications Web Push
  pushSubscriptions PushSubscription[]
  notificationPrefs NotificationPrefs?
  notificationLogs  NotificationLog[]

  // Coach IA (page Analyse)
  coachDebriefs CoachDebrief[]
  coachChats    CoachChat[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  refresh_token_expires_in Int?
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ───────── Activités ─────────
model Activity {
  id             String       @id @default(cuid())
  userId         String
  type           ActivityType
  title          String
  notes          String?
  feeling        Feeling?
  startedAt      DateTime
  distanceM      Float        @default(0)
  movingTimeS    Int          @default(0)
  elapsedTimeS   Int?
  elevationGainM Float        @default(0)
  calories       Int?
  avgHr          Int?
  maxHr          Int?
  avgPower       Int?                    // W (home trainer, capteur de puissance)
  maxPower       Int?
  polyline       String?      @db.Text   // trace simplifiée (polyline encodée)
  trackPoints    Json?                   // [{lat,lng,ele,t}] pour graphes altitude/vitesse
  startLat       Float?
  startLng       Float?
  source         String       @default("manual") // manual | gpx | fit | strava | mywhoosh
  externalId     String?                 // Activity ID Strava, empreinte MyWhoosh…
  weather        Json?                   // {tempC, precipMm} à l'heure de départ
  story          String?                 // anecdote générée à l'enregistrement
  dedupeKey      String?      // début à la minute (UTC) : évite les doublons à l'import
  rpe            Int?                    // effort ressenti 1-10 (échelle de Borg CR-10)
  load           Float?                  // charge d'entraînement calculée (lib/load.ts), en points type TSS
  loadSource     String?                 // "power" | "hr" | "rpe" | "estimate"
  srpe           Int?                    // charge ressentie (sRPE, Foster) = RPE × durée en minutes ; null sans RPE
  kind           WorkoutKind?            // muscu : moitié du corps travaillée (null = séance d'avant ce champ, déduite des exercices)
  templateId     String?                 // muscu : modèle dont la séance est partie
  zoneRibbon     Json?                   // [{ z: 1..6, f: fraction du temps }] : ruban de zones, lib/art/zone-ribbon.ts ; null sans FC, puissance (vélo) ni allure (course)
  zoneRibbonSource String?               // "hr" | "power" | "pace" : série d'où vient le ruban ; null = pas de ruban (ou ruban d'avant ce champ)
  zoneRibbonRef  Float?                  // seuil utilisé : FC max (bpm), FTP (W) ou VMA (km/h) ; sert à repérer les rubans périmés quand il change
  isInterval     Boolean?                // séance d'intervalles (lib/art/interval.ts, 10 s de résolution, rubans FC et allure) ; null = non évalué
  isRace         Boolean      @default(false) // compétition : case « Compétition » de Strava (import), ou choix manuel sur la fiche
  sessionType    String?                 // choix manuel : "interval" | "easy" | "race" ; null = automatique. Jamais écrit par un recalcul (lib/art/session-type.ts)
  intervalReps   Int?                    // nombre de répétitions détectées
  zoneRibbonAt   DateTime?               // dernier calcul du ruban, même sans résultat ; null = jamais calculé ou à recalculer (lib/data/zone-ribbon.ts)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  photos    ActivityPhoto[]
  exercises WorkoutExercise[]
  stream    ActivityStream?
  gear      Gear[]
  raceEvent RaceEvent?

  // Programmes v2
  plannedSession PlannedSession? // séance du programme que cette activité réalise
  athleteMetrics AthleteMetric[] // tests (VMA…) mesurés pendant cette activité

  @@unique([userId, dedupeKey])
  @@unique([userId, source, externalId])
  @@index([userId, startedAt(sort: Desc)])
}

model ActivityPhoto {
  id         String   @id @default(cuid())
  activityId String
  url        String
  key        String?  // clé Uploadthing / public_id Cloudinary
  position   Int      @default(0)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

// ───────── Social ─────────
// ───────── Objectifs, records, badges ─────────
model Goal {
  id        String        @id @default(cuid())
  userId    String
  metric    GoalMetric
  period    GoalPeriod
  target    Float         // m, s, m D+ ou nombre d'activités
  type      ActivityType? // null = tous sports
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model PersonalRecord {
  id         String       @id @default(cuid())
  userId     String
  kind       RecordKind
  type       ActivityType
  value      Float        // secondes ou mètres selon `kind`
  activityId String?
  achievedAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, type])
}

model Badge {
  id          String @id // ex: "first-5k", "streak-7"
  name        String
  description String
  icon        String
  users UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  /// null = obtenu mais pas encore validé par l'utilisateur (« Nouveau »)
  acknowledgedAt DateTime?
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([userId, acknowledgedAt])
}

// ───────── Programme d'entraînement — ANCIENNE VERSION (remplacée par Program, à supprimer une fois l'UI migrée) ─────────
model TrainingPlan {
  id        String       @id @default(cuid())
  userId    String
  sport     ActivityType
  goalLabel String
  weeks     Int
  days      Int
  data      Json         // plan complet généré (semaines, séances)
  done      String[]     // clés des séances cochées : "semaine-index"
  createdAt DateTime     @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ───────── Musculation : un bloc par exercice (à découper plus finement en séries si besoin) ─────────
model WorkoutExercise {
  id         String   @id @default(cuid())
  activityId String
  position   Int
  name       String
  sets       Int
  reps       Int
  loadKg     Float?
  restS      Int?
  comment    String?
  setsDetail Json?   // [{ reps, loadKg, done, rir?, isWarmup?, durationS? }] : le réel série par série ; sets/reps/loadKg restent le prévu
  exerciseId String? // Programmes v2 : exercice du catalogue (null = texte libre non rapproché)
  slotId     String? // Programmes v2 : emplacement du programme suivi
  activity Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  exercise Exercise?            @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  slot     ProgramExerciseSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([activityId, position])
  @@index([exerciseId])
}

/// Modèle de séance de muscu : la structure seulement (exercices, séries, repos), jamais les performances.
/// Les deux modèles intégrés (« Haut du corps », « Bas + abdos ») sont créés pour chaque utilisateur (lib/workout/builtin.ts).
model WorkoutTemplate {
  id        String      @id @default(cuid())
  userId    String
  name      String
  kind      WorkoutKind @default(LIBRE)
  isBuiltIn Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises  WorkoutTemplateExercise[]
  activities Activity[]

  @@unique([userId, name])
}

model WorkoutTemplateExercise {
  id           String  @id @default(cuid())
  templateId   String
  order        Int
  exerciseCode String  // code Lafay en majuscule (« B ») ; pour un exercice libre, son nom
  variant      String? // « B2 » ; null hors échelle Lafay
  sets         Int
  targetReps   Int
  restSec      Int     // entre deux séries
  restAfterSec Int     // avant l'exercice suivant
  loadKg       Float?
  note         String?
  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, order])
}

// ───────── Séries complètes à 1 Hz (puissance, cardio, cadence) : courbe de puissance, zones, intervalles ─────────
model ActivityStream {
  activityId String @id
  data       Json   // { t0, n, power[], hr[], cad[] } : une valeur par seconde
  curve      Json?  // meilleure puissance moyenne sur 5 s, 30 s, 1 min, 5 min, 20 min, 1 h
  avgCad     Int?
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// ───────── Itinéraires : boucles proposées (ORS) et notées avec OpenStreetMap (Overpass) ─────────
model SuggestedRoute {
  id         String       @id @default(cuid())
  userId     String
  sport      ActivityType // RUN ou RIDE
  variant    String?      // vélo : "road" | "trail"
  minutes    Int          // temps visé
  startLat   Float
  startLng   Float
  polyline   String       @db.Text // trace encodée (lib/polyline.ts)
  elevation  Json         // altitude (m, entiers), un point par point de la trace
  distanceM  Float
  ascentM    Float
  estMinutes Int
  label      String       // « La nature », « Les curiosités », « L'équilibrée »
  why        String       // « 72 % en forêt ou au bord de l'eau · 3 points de vue · 1 point d'eau »
  scores     Json         // lib/routes/score.ts : RouteScores
  pois       Json         // [{ id, name, type, lat, lng, km }]
  weather    Json?        // lib/weather/rules.ts : RouteWeather (météo prévue au départ choisi), null si Open-Meteo n'a pas répondu
  saved      Boolean      @default(false)
  createdAt  DateTime     @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, saved, createdAt(sort: Desc)])
}

/// Habitudes de parcours (lib/habits) : carte de chaleur, classiques et bifurcations, recalculées après chaque synchro.
model HabitMap {
  id        String       @id @default(cuid())
  userId    String
  sport     ActivityType // RUN ou RIDE
  lat0      Float        // latitude de référence de la grille (projection locale)
  cellM     Int          // taille des cases (m)
  cells     Json         // [[ligne, colonne, nombre de sorties]]
  classics  Json         // lib/habits/build.ts : StoredClassic[]
  junctions Json         // lib/habits/grid.ts : Junction[]
  traces    Int          // sorties avec trace GPS prises en compte
  builtAt   DateTime     @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sport])
}

/// Réponses Overpass découpées par tuile (lib/routes/overpass.ts), gardées 30 jours.
model OverpassCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())
}

/// Prévisions Open-Meteo brutes (lib/weather/open-meteo.ts), par maille de 0,05° et par heure, gardées 30 min.
model WeatherCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())
}

// ───────── Seuils personnels (vides = estimés automatiquement) ─────────
model UserZones {
  userId    String   @id
  ftp       Int?     // watts
  hrMax     Int?     // bpm, saisi : prime toujours sur l'estimation et n'est jamais écrasé
  hrMaxEstimate Int? // bpm, estimé (lib/physio/hr-max.ts), rafraîchi chaque nuit tant que hrMax est vide
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────── Échéances (courses, objectifs datés) ─────────
model RaceEvent {
  id              String       @id @default(cuid())
  userId          String
  name            String
  date            DateTime
  sport           ActivityType
  targetDistance  Float?       // km
  targetElevation Float?       // m de D+
  // Inscription (NextRun, Klikego…) : tout est optionnel, les échéances saisies à la main restent valides
  startTime        String?                       // "HH:mm", heure locale Europe/Paris ; `date` reste la date à midi UTC
  eventName        String?                       // "Dinard Off Course 2027"
  platform         RacePlatform @default(OTHER)
  url              String?                       // page d'inscription ; sert de clé d'import
  location         String?
  priceCents       Int?
  requiredDocument String?                       // "Licence ou PPS"
  bibNumber        String?
  goalTimeS        Int?                          // objectif de temps
  status           RaceStatus   @default(REGISTERED)
  activityId       String?      @unique          // l'activité du jour J
  resultTimeS      Int?
  rankOverall      Int?
  rankCategory     Int?
  participants     Int?
  notes            String?
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  // Programmes v2
  goals           TrainingGoal[]   // objectifs visant cette course
  plannedSessions PlannedSession[] // jour de course dans un programme

  @@unique([userId, url])
  @@index([userId, date])
}

// ───────── Matériel : vélos, home trainer, chaussures et leurs composants d'usure ─────────
model Gear {
  id          String         @id @default(cuid())
  userId      String
  parentId    String?        // composant (chaîne, cassette…) monté sur un vélo ou un home trainer : hérite de ses sorties
  kind        GearKind
  name        String
  sports      ActivityType[] // sports pour lesquels il est proposé à l'enregistrement
  isDefault   Boolean        @default(false) // affecté d'office aux nouvelles sorties de ces sports
  startKm     Float          @default(0)     // km déjà parcourus avant le suivi dans Pulse
  limitKm     Float?         // seuil critique ; null = simple compteur
  installedAt DateTime       @default(now()) // un composant ne compte que les sorties de son support à partir de cette date
  retiredAt   DateTime?
  createdAt   DateTime       @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Gear?      @relation("GearParts", fields: [parentId], references: [id], onDelete: Cascade)
  parts      Gear[]     @relation("GearParts")
  activities Activity[]

  @@index([userId, retiredAt])
}

// ═════════════════════════════════════════════════════════════════════
//  PROGRAMMES V2 — objectifs dynamiques, plans périodisés, muscu structurée
//  Catalogue (modèles de plans, programmes, exercices) : dans le code (lib/training/catalog).
//  Ici : ton programme instancié et son suivi. Une séance réalisée = une Activity.
//  Unités : m, s, s/km, km/h, kg. @db.Date = jour local (Europe/Paris).
//  Règle « 1 programme ACTIVE par sport » : appliquée dans le code à l'activation.
// ═════════════════════════════════════════════════════════════════════

enum GoalType {
  RUN_TARGET_TIME      // un chrono sur une distance / une course : semi en 1:44:59
  RUN_FINISH           // finir une distance
  RUN_VMA              // atteindre une VMA
  RUN_BASE             // reprise, foncier
  STRENGTH_HYPERTROPHY // prise de masse
  STRENGTH_FORCE       // gagner en force
  STRENGTH_MAINTENANCE // maintenir avec un volume réduit
  STRENGTH_LIFT_TARGET // une perf précise : 15 tractions, 100 kg au développé couché
}
enum GoalStatus {
  ACTIVE
  ACHIEVED
  MISSED
  ABANDONED
}
enum Feasibility {
  REALISTIC
  AMBITIOUS
  VERY_AMBITIOUS
  UNKNOWN
}
enum TargetUnit {
  KG
  REPS
  SECONDS
  KMH
}
enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}
enum SchedulingMode {
  FIXED_DAYS // jours fixes (running)
  FLEXIBLE   // ordre imposé, jours libres (muscu : A → B → A…)
}
enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
enum PhaseType {
  BASE            // running : foncier
  BUILD           // développement
  SPECIFIC        // allure spécifique
  TAPER           // affûtage
  POST_RACE       // récupération
  ACCUMULATION    // muscu : volume
  INTENSIFICATION // charges
  DELOAD          // décharge
  MAINTENANCE
}
enum SessionKind {
  EASY            // endurance fondamentale
  RECOVERY
  LONG_RUN
  THRESHOLD       // seuil / tempo
  INTERVALS_SHORT // VMA courte
  INTERVALS_LONG  // fractionné long
  RACE_PACE       // allure objectif
  FARTLEK
  HILLS
  PROGRESSIVE
  VMA_TEST
  RACE
  CROSS_TRAINING  // vélo / home trainer en remplacement
  STRENGTH_WORKOUT
  MOBILITY
}
enum SessionStatus {
  PLANNED
  COMPLETED
  PARTIAL
  SKIPPED
  MOVED
}
enum MetricType {
  VMA_KMH
  HR_MAX
  HR_REST
  HR_THRESHOLD
  THRESHOLD_PACE_S_KM
  FTP_W
  BODYWEIGHT_KG
}
enum MetricSource {
  TEST
  RACE
  ESTIMATED
  MANUAL
  INTERVALS
}
enum Equipment {
  BARBELL
  DUMBBELL
  KETTLEBELL
  MACHINE
  CABLE
  BAND
  BODYWEIGHT
  PULLUP_BAR
  RINGS
  BENCH
  ROMAN_CHAIR // chaise romaine : dips, relevés de jambes, extensions lombaires
  OTHER
}
enum LoadType {
  EXTERNAL            // barre, haltères, machine
  BODYWEIGHT          // poids du corps (Lafay)
  WEIGHTED_BODYWEIGHT // tractions / dips lestés
  ASSISTED            // avec élastique
  TIMED               // gainage, isométrie
}
enum Mechanic {
  COMPOUND
  ISOLATION
}
enum MuscleGroup {
  CHEST
  BACK
  LATS
  TRAPS
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  ABS
  OBLIQUES
  LOWER_BACK
  GLUTES
  QUADS
  HAMSTRINGS
  CALVES
  ADDUCTORS
  FULL_BODY
}
enum SetType {
  STRAIGHT
  TOP_SET_BACKOFF
  PYRAMID
  DROP_SET
  REST_PAUSE
  MYO_REPS
  AMRAP
  TIMED
}
enum ProgressionRule {
  DOUBLE_PROGRESSION // haut de fourchette sur toutes les séries → + charge
  LINEAR_LOAD        // + charge à chaque réussite, deload après X échecs
  REPS_THEN_VARIANT  // poids du corps : + reps puis variante plus dure
  RIR_AUTOREGULATED
  MAINTAIN
  NONE
}

/// Historique des métriques (VMA, FC…). La dernière valeur sert à calculer allures et pronostics.
/// UserZones (ftp, hrMax) reste la valeur courante utilisée ailleurs dans l'app.
model AthleteMetric {
  id         String       @id @default(cuid())
  userId     String
  type       MetricType
  value      Float
  measuredAt DateTime
  source     MetricSource
  activityId String?
  note       String?
  createdAt  DateTime     @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId, type, measuredAt(sort: Desc)])
}

/// Objectif dynamique (remplace les objectifs fixes 5 km / 10 km de l'ancien TrainingPlan).
/// Les objectifs de volume du dashboard (Goal) restent séparés.
model TrainingGoal {
  id                  String       @id @default(cuid())
  userId              String
  sport               ActivityType // RUN ou WORKOUT
  type                GoalType
  title               String       // « Semi de Rennes en 1:44:59 »
  status              GoalStatus   @default(ACTIVE)
  targetDate          DateTime?    @db.Date
  // Running
  distanceM           Int?
  targetTimeS         Int?
  raceEventId         String?      // course existante (RaceEvent)
  // Muscu / cible chiffrée
  exerciseId          String?
  targetValue         Float?
  targetUnit          TargetUnit?
  // Pronostic, recalculé à chaque nouvelle métrique
  baselineValue       Float?
  predictedTimeS      Int?
  requiredVmaKmh      Float?
  feasibility         Feasibility  @default(UNKNOWN)
  predictionUpdatedAt DateTime?
  achievedAt          DateTime?
  achievedValue       Float?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  raceEvent RaceEvent? @relation(fields: [raceEventId], references: [id], onDelete: SetNull)
  exercise  Exercise?  @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  programs  Program[]

  @@index([userId, status])
}

/// Programme instancié depuis le catalogue. Un seul ACTIVE par sport → la Home affiche 1 carte running + 1 carte muscu.
model Program {
  id                 String          @id @default(cuid())
  userId             String
  sport              ActivityType    // RUN ou WORKOUT
  goalId             String?
  name               String          // « Prépa semi 1:45 — 12 semaines »
  templateKey        String          // clé du catalogue : "run.race-time", "strength.hypertrophy-fb3"
  templateVersion    Int
  status             ProgramStatus   @default(DRAFT)
  schedulingMode     SchedulingMode  @default(FIXED_DAYS)
  startDate          DateTime        @db.Date
  endDate            DateTime        @db.Date
  totalWeeks         Int
  sessionsPerWeek    Int
  preferredDays      Int[]           // jours ISO : 1 = lundi … 7 = dimanche
  keySessionDay      Int?
  longRunDay         Int?
  level              ExperienceLevel @default(INTERMEDIATE)
  generatorInput     Json            // paramètres de génération (VMA, dispos, charges de départ…)
  revision           Int             @default(1)
  lastRecalibratedAt DateTime?
  activatedAt        DateTime?
  pausedAt           DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal     TrainingGoal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  phases   ProgramPhase[]
  weeks    ProgramWeek[]
  sessions PlannedSession[]
  workouts ProgramWorkout[]

  @@index([userId, sport, status])
}

/// Bloc de périodisation (foncier → développement → spécifique → affûtage ; ou cycles muscu).
model ProgramPhase {
  id        String    @id @default(cuid())
  programId String
  order     Int
  type      PhaseType
  name      String
  focus     String?   // phrase courte affichée sur la Home
  program Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  weeks   ProgramWeek[]

  @@unique([programId, order])
}

model ProgramWeek {
  id              String   @id @default(cuid())
  programId       String
  phaseId         String
  number          Int      // 1 … totalWeeks
  startDate       DateTime @db.Date // lundi
  isRecovery      Boolean  @default(false) // assimilation / deload
  targetDistanceM Int?
  targetLoad      Int?     // même échelle que Activity.load
  volumeFactor    Float    @default(1) // muscu : séries × facteur
  intensityFactor Float    @default(1) // muscu : charges × facteur
  note            String?
  program  Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  phase    ProgramPhase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  sessions PlannedSession[]

  @@unique([programId, number])
}

/// Séance prévue (running ou muscu). Réalisée = reliée à une Activity.
model PlannedSession {
  id                  String        @id @default(cuid())
  programId           String
  weekId              String
  userId              String        // dénormalisé : « aujourd'hui » en une requête
  sport               ActivityType
  kind                SessionKind
  date                DateTime      @db.Date
  orderInWeek         Int
  title               String        // « 10 × 400 m à VMA »
  description         String?
  isKeySession        Boolean       @default(false)
  structure           Json?         // running : RunWorkoutStructure (types/training.ts), intensités relatives
  plannedDurationS    Int?
  plannedDistanceM    Int?
  plannedLoad         Int?
  workoutId           String?       // muscu : séance type (Full Body A…)
  raceEventId         String?       // jour de course
  status              SessionStatus @default(PLANNED)
  originalDate        DateTime?     @db.Date
  completedActivityId String?       @unique
  complianceScore     Int?          // 0–100 : réalisé vs prévu
  skipReason          String?
  completedAt         DateTime?
  intervalsEventId    String?       // id de l'événement WORKOUT créé sur Intervals.icu (→ Garmin) ; external_id = "pulse-<id>"
  intervalsSyncedAt   DateTime?     // dernier envoi réussi vers le calendrier Intervals.icu
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  program           Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  week              ProgramWeek     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout           ProgramWorkout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  raceEvent         RaceEvent?      @relation(fields: [raceEventId], references: [id], onDelete: SetNull)
  completedActivity Activity?       @relation(fields: [completedActivityId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([programId, status, date])
  @@index([weekId])
}

/// Bibliothèque d'exercices (seedée depuis le code + exos perso).
model Exercise {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  aliases          String[]      // rapproche les saisies libres : « DC », « bench »
  equipment        Equipment
  loadType         LoadType
  mechanic         Mechanic?
  primaryMuscles   MuscleGroup[]
  secondaryMuscles MuscleGroup[]
  difficulty       Int?          // 1–10 : échelle des variantes poids du corps
  harderVariantId  String?
  instructions     String?
  isCustom         Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  harderVariant  Exercise?             @relation("ExerciseVariant", fields: [harderVariantId], references: [id], onDelete: SetNull)
  easierVariants Exercise[]            @relation("ExerciseVariant")
  slots          ProgramExerciseSlot[]
  logs           WorkoutExercise[]
  goals          TrainingGoal[]
}

/// Séance type d'un programme muscu : « Full Body A », « Push »…
model ProgramWorkout {
  id                   String @id @default(cuid())
  programId            String
  key                  String // "A", "B"
  name                 String
  order                Int
  estimatedDurationMin Int?
  program         Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  slots           ProgramExerciseSlot[]
  plannedSessions PlannedSession[]

  @@unique([programId, key])
}

/// Un exercice dans une séance type : prescription + règle de progression + état courant.
model ProgramExerciseSlot {
  id                String          @id @default(cuid())
  workoutId         String
  exerciseId        String          // exercice actuel (change si passage à une variante plus dure)
  order             Int
  supersetGroup     String?
  setType           SetType         @default(STRAIGHT)
  sets              Int
  repMin            Int?
  repMax            Int?
  durationS         Int?
  targetRir         Int?
  tempo             String?
  restS             Int?
  warmupSets        Int             @default(0)
  progressionRule   ProgressionRule
  loadIncrementKg   Float?
  repIncrement      Int?
  deloadAfterStalls Int?
  deloadPct         Float?
  currentLoadKg     Float?          // état courant, mis à jour après chaque séance
  currentRepTarget  Int?
  stallCount        Int             @default(0)
  lastProgressedAt  DateTime?
  notes             String?
  workout  ProgramWorkout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise          @relation(fields: [exerciseId], references: [id])
  logs     WorkoutExercise[]

  @@unique([workoutId, order])
}

// ───────── Notifications Web Push (lib/push, lib/notify) ─────────
/// Petits secrets générés par l'app elle-même (ex. paire VAPID quand elle n'est pas fournie par l'environnement).
model AppSecret {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
}

/// Abonnement push d'un navigateur (un par appareil / navigateur). Supprimé quand le service push répond 404 ou 410.
model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime  @default(now())
  lastOkAt  DateTime? // dernier envoi accepté par le service push
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Quelles notifications envoyer (une ligne par utilisateur, créée au premier réglage).
model NotificationPrefs {
  userId    String   @id
  morning   Boolean  @default(true) // coach du matin
  reminder  Boolean  @default(true) // rappel avant la séance du programme
  weekly    Boolean  @default(true) // bilan du dimanche soir
  morningCoachTime String @default("06:00") // heure Paris « HH:mm » à partir de laquelle part le coach du matin
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Journal d'envoi : au plus une notification de chaque type par jour (heure de Paris).
model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  kind   String   // "morning" | "reminder" | "weekly"
  day    String   // AAAA-MM-JJ dans le fuseau de l'utilisateur
  sentAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, day])
}

/// Debrief du coach IA (page Analyse), un par onglet et par période ; régénéré quand les faits changent.
model CoachDebrief {
  id           String   @id @default(cuid())
  userId       String
  scope        String   // "all" | "RUN" | "WORKOUT"
  periodKey    String   // "<semaines>:<AAAA-MM-JJ de fin>"
  factsHash    String   // empreinte des faits envoyés (+ version de la doctrine et modèle)
  data         Json     // Debrief (lib/coach/ai.ts)
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, periodKey])
  @@index([userId, updatedAt])
}

/// Conversation avec le coach IA (écran /coach). Seule la plus récente est affichée ; « Nouvelle conversation » en ouvre une autre.
model CoachChat {
  id        String         @id @default(cuid())
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, updatedAt])
}

model CoachMessage {
  id           String   @id @default(cuid())
  chatId       String
  role         String   // "user" | "assistant"
  content      String
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  createdAt    DateTime @default(now())
  chat CoachChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}
