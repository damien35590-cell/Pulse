generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")        // pooled (Neon / Supabase pgbouncer)
  directUrl = env("DIRECT_URL")        // direct, for migrations
}

// ───────── Enums ─────────
enum ActivityType {
  RUN
  RIDE
  SWIM
  HIKE
  WALK
  WORKOUT
  OTHER
}
enum Feeling {
  GREAT
  GOOD
  OK
  TIRED
  HARD
}
enum GoalMetric {
  DISTANCE
  TIME
  ELEVATION
  ACTIVITIES
}
enum GoalPeriod {
  WEEK
  MONTH
  YEAR
}
enum RecordKind {
  LONGEST_DISTANCE
  LONGEST_TIME
  BEST_5K
  BEST_10K
  BEST_HALF
  BEST_ELEVATION
}

// ───────── Auth (NextAuth + PrismaAdapter) ─────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  bio           String?
  weightKg      Float?    // estimation des calories
  timezone      String    @default("Europe/Paris")
  ageBand       String?   // "30-39" : sert aux repères de comparaison
  sex           String?   // "H" | "F"
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  activities Activity[]
  goals      Goal[]
  plans      TrainingPlan[]
  records    PersonalRecord[]
  badges     UserBadge[]
  
  // Nouvelles relations
  zones      UserZones?
  equipments Equipment[]
  raceEvents RaceEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ───────── Activités ─────────
model Activity {
  id             String       @id @default(cuid())
  userId         String
  type           ActivityType
  title          String
  notes          String?
  feeling        Feeling?
  startedAt      DateTime
  distanceM      Float        @default(0)
  movingTimeS    Int          @default(0)
  elapsedTimeS   Int?
  elevationGainM Float        @default(0)
  calories       Int?
  avgHr          Int?
  maxHr          Int?
  avgPower       Int?                    // W (home trainer, capteur de puissance)
  maxPower       Int?
  polyline       String?      @db.Text   // trace simplifiée (polyline encodée)
  trackPoints    Json?                   // [{lat,lng,ele,t}] pour graphes altitude/vitesse
  startLat       Float?
  startLng       Float?
  source         String       @default("manual") // manual | gpx | fit | strava | mywhoosh
  externalId     String?                 // Activity ID Strava, empreinte MyWhoosh…
  weather        Json?                   // {tempC, precipMm} à l'heure de départ
  story          String?                 // anecdote générée à l'enregistrement
  dedupeKey      String?      // début à la minute (UTC) : évite les doublons à l'import
  isCommute      Boolean      @default(false) // Permet d'exclure les trajets utilitaires
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      ActivityPhoto[]
  
  // Nouvelles relations
  timeSeries  TimeSeriesData?
  equipmentId String?
  equipment   Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@unique([userId, source, externalId])
  @@index([userId, startedAt(sort: Desc)])
}

model ActivityPhoto {
  id         String   @id @default(cuid())
  activityId String
  url        String
  key        String?  // clé Uploadthing / public_id Cloudinary
  position   Int      @default(0)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

// ───────── Objectifs, records, badges ─────────
model Goal {
  id        String        @id @default(cuid())
  userId    String
  metric    GoalMetric
  period    GoalPeriod
  target    Float         // m, s, m D+ ou nombre d'activités
  type      ActivityType? // null = tous sports
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model PersonalRecord {
  id         String       @id @default(cuid())
  userId     String
  kind       RecordKind
  type       ActivityType
  value      Float        // secondes ou mètres selon `kind`
  activityId String?
  achievedAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, type])
}

model Badge {
  id          String @id // ex: "first-5k", "streak-7"
  name        String
  description String
  icon        String
  users UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

// ───────── Programme d'entraînement ─────────
model TrainingPlan {
  id        String       @id @default(cuid())
  userId    String
  sport     ActivityType
  goalLabel String
  weeks     Int
  days      Int
  data      Json         // plan complet généré (semaines, séances)
  done      String[]     // clés des séances cochées : "semaine-index"
  createdAt DateTime     @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ───────── NOUVEAUX MODULES ─────────

// 1. Seuils physiologiques (PPR, TiZ)
model UserZones {
  id        String   @id @default(cuid())
  userId    String   @unique
  ftp       Int?     // Functional Threshold Power (Watts)
  maxHr     Int?     // Fréquence cardiaque maximale (BPM)
  restHr    Int?     // Fréquence cardiaque de repos
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 2. Séries temporelles 1 Hz (PPR, Détection d'intervalles)
model TimeSeriesData {
  id         String   @id @default(cuid())
  activityId String   @unique
  
  // Format attendu : { watts: [...], hr: [...], cadence: [...], time: [...] }
  data       Json

  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// 3. Gestion du Matériel (Gear Tracker)
model Equipment {
  id           String     @id @default(cuid())
  userId       String
  name         String     // ex: "Genesis Croix de Fer", "Asics Trabuco"
  type         String     // ex: "BIKE", "SHOES"
  maxLifespan  Float      // Durée de vie max (en km ou mètres)
  currentUsage Float      @default(0) // Usure actuelle (en km ou mètres)
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities   Activity[] 

  @@index([userId])
}

// 4. Échéances et Courses (Event Timeline)
model RaceEvent {
  id              String       @id @default(cuid())
  userId          String
  name            String       // ex: "Trail Glazig 28km"
  date            DateTime
  sport           ActivityType
  targetDistance  Float        // en mètres ou km
  targetElevation Float?       // en mètres
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date(sort: Asc)])
}
