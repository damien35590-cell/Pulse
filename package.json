    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "fit-file-parser": "^1.21.0",
    "framer-motion": "^11.11.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "next": "^14.2.15",
    "next-auth": "^4.24.10",
    "react": "^18.3.1",
